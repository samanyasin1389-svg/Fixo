{
  "name": "@fixo/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:all": "pnpm run build:deps && pnpm exec concurrently -k \"pnpm run dev:ui\" \"pnpm run dev\"",
    "build:deps": "pnpm --filter @fixo/shared build && pnpm --filter @fixo/mcp-network build && pnpm --filter @fixo/mcp-apps build",
    "build": "pnpm run build:deps && tsc -p tsconfig.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.0",
    "@fixo/mcp-apps": "workspace:*",
    "@fixo/mcp-network": "workspace:*",
    "@fixo/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.8.0",
    "ai": "^4.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
